# Save Gaza Backend — Environment Variables

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/savegaza?schema=public"

# Redis (optional — falls back to in-memory cache if not provided)
REDIS_URL=

# JWT Auth
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudflare Turnstile (anti-bot on /submit)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Sentry (optional — set to enable error tracking)
SENTRY_DSN=