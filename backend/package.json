    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.0",
    "winston": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "prisma": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
